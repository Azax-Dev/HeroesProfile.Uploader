<Window x:Class="Heroesprofile.Uploader.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Heroesprofile.Uploader.Windows"
        xmlns:helpers="clr-namespace:Heroesprofile.Uploader.Windows.UIHelpers"
        xmlns:common="clr-namespace:Heroesprofile.Uploader.Common;assembly=Heroesprofile.Uploader.Common"
        mc:Ignorable="d" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Title="Settings" SizeToContent="WidthAndHeight"
        KeyDown="Window_KeyDown" Closing="Window_Closing">
    <Window.Resources>
        <helpers:FlagsConverter x:Key="flags" />
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Column="0" Grid.Row="0" Margin="20, 20, 20, 0" helpers:MarginSetter.Margin="0, 8, 0, 0" Width="360">
            <TextBlock Text="Replay folder" FontWeight="Bold" Margin="0, 0, 1, 0" />
            <TextBlock FontSize="10" Foreground="{StaticResource DimmedTextBrush}" TextWrapping="Wrap" Margin="0, 0, 1, 0"
                       Text="Leave empty to use the default Documents location. Set it if your Documents folder has moved, or when running through Wine/Proton, where the replays live inside the game's prefix." />
            <TextBox x:Name="ReplayPathBox" Text="{Binding App.Settings.ReplayPath, Mode=TwoWay}" TextWrapping="Wrap" TextChanged="ReplayPathBox_TextChanged" />
            <TextBlock x:Name="ReplayPathStatus" FontSize="10" TextWrapping="Wrap" Margin="0, 0, 1, 0" />
            <StackPanel Orientation="Horizontal" helpers:MarginSetter.Margin="0, 0, 8, 0">
                <Button Content="Browse..." Padding="10, 2" Click="BrowseReplayPath_Click" />
                <Button Content="Use default" Padding="10, 2" Click="ResetReplayPath_Click" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1" Grid.Row="0" Margin="20, 20, 20, 0" helpers:MarginSetter.Margin="0, 8, 0, 0" MinWidth="150">
            <TextBlock Text="Theme" FontWeight="Bold" Margin="0, 0, 1, 0" />
            <ComboBox SelectedValue="{Binding App.Settings.Theme, Mode=TwoWay}" SelectedValuePath="Tag">
                <ComboBox.Items>
                    <ComboBoxItem Content="Light" Tag="Default" />
                    <ComboBoxItem Content="Dark" Tag="MetroDark" />
                </ComboBox.Items>
            </ComboBox>

            <StackPanel Margin="0, 40, 0, 0" x:Name="PreReleasePanel" Visibility="Collapsed">
                <CheckBox Content="Allow beta updates" FontWeight="SemiBold" IsChecked="{Binding App.Settings.AllowPreReleases}" />
                <TextBlock HorizontalAlignment="Left" FontSize="10" TextWrapping="Wrap" MaxWidth="150" Margin="0, 0, 1, 0"
                           Text="Intended for developers. Allows automatic updates to untested pre-release versions. Needs a restart to take effect." />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" Margin="20" helpers:MarginSetter.Margin="0, 8, 0, 0" Width="520">
            <TextBlock Text="Twitch Extension" FontWeight="Bold" Margin="0, 16, 1, 0" />
            <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource DimmedTextBrush}"
                       Text="Shows your viewers your lobby, heroes and talents as they are picked. Connect your channel and create an uploader key at the Twitch Extension section of heroesprofile.com/Api/Account, paste it here, then tick Twitch Extension on the main window." />
            <PasswordBox x:Name="TwitchKeyBox" Height="23" PasswordChanged="TwitchKeyBox_PasswordChanged" />
            <StackPanel Orientation="Horizontal" helpers:MarginSetter.Margin="0, 0, 8, 0">
                <Button x:Name="TwitchValidateButton" Content="Check key" Padding="10, 2" Click="TwitchValidate_Click" />
                <Button Content="Open Twitch settings" Padding="10, 2" Click="TwitchPortal_Click" />
            </StackPanel>
            <TextBlock x:Name="TwitchKeyStatus" FontSize="10" TextWrapping="Wrap" Margin="0, 0, 1, 0" />

            <TextBlock Text="Webhook" FontWeight="Bold" Margin="0, 16, 1, 0" />
            <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource DimmedTextBrush}"
                       Text="A webhook lets another program react to your matches automatically. Enter a url and this app will send it an HTTP POST whenever your prematch or postmatch page opens, with a small json payload identifying the event and linking to the match page:" />
            <TextBlock FontFamily="Consolas" FontSize="11" Foreground="{StaticResource DimmedTextBrush}" TextWrapping="Wrap"
                       Text='{}{"event": "prematch", "url": "https://www.heroesprofile.com/PreMatch/...", "content": "Match started — ...", "text": "Match started — ..."}' />
            <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource DimmedTextBrush}"
                       Text="The payload works out of the box with Discord and Slack webhook urls ('content' and 'text' carry a ready-to-post message), so your matches can be announced in a channel with no bot required. Custom receivers can use the 'event' and 'url' fields instead. Requires the Prematch/Postmatch Page options to be enabled. Leave empty to disable." />
            <TextBox x:Name="WebhookUrlBox" Text="{Binding App.Settings.WebhookUrl, Mode=TwoWay}" Height="23" TextChanged="WebhookUrlBox_TextChanged" />
            <TextBlock x:Name="WebhookError" Foreground="{StaticResource StatusUploadFailedBrush}" FontSize="10" TextWrapping="Wrap" Visibility="Collapsed"
                       Text="Invalid url. Must start with http:// or https://" />
        </StackPanel>
    </Grid>
</Window>
